# Copy to a private file, source it, and adjust values for each cluster.
# Do not commit credentials, customer data, or generated API keys.

# OpenShift / Lago
LAGO_NAMESPACE=lago
LAGO_RELEASE=lago
LAGO_CHART_VERSION=2.1.1
LAGO_VALUES_FILE=/path/to/lago-values.yaml
OPENSHIFT_REGISTRY=image-registry.openshift-image-registry.svc:5000
LAGO_IMAGE_PROJECT=lago
LAGO_API_IMAGE_TAG=ocp-api-example
LAGO_FRONT_IMAGE_TAG=ocp-front-example
LAGO_FRONT_HTTP_PORT=8080
LAGO_FRONT_BUILD_CONFIG=lago-front-ocp
LAGO_FRONT_IMAGE_STREAM=lago-front-ocp
LAGO_FRONT_ROUTE=lago-front
LAGO_API_ROUTE=lago-api

# Grafana Operator / Thanos
GRAFANA_NAMESPACE=api-observability
GRAFANA_DASHBOARD_NAME=api-usage-billing
GRAFANA_INSTANCE_LABEL_KEY=dashboards
GRAFANA_INSTANCE_LABEL_VALUE=grafana
GRAFANA_DATASOURCE_NAME=Thanos
THANOS_URL=https://thanos-querier.openshift-monitoring.svc:9091
GRAFANA_ROUTE=https://replace-with-your-grafana-route

# Change these selectors to match the series shown in Grafana Explore.
METRICS_JOB=ai-gateway/internal-ai-gateway
METRICS_REPORTER=source
GRAFANA_DASHBOARD_UID=api-usage-billing-workshop
GRAFANA_DASHBOARD_TITLE="Connectivity Link API usage and cost estimate"

# Illustrative dashboard estimate only; not a Lago price or invoice.
ESTIMATED_PRICE_PER_REQUEST=0.05
CURRENCY=USD

# Supply Lago secrets at runtime from an approved secret store or prompt.
# LAGO_URL=https://your-lago-api
# LAGO_API_KEY must not be stored in this file or committed.
# LAGO_EXTERNAL_SUBSCRIPTION_ID=your-test-subscription
# LAGO_EVENT_CODE=api_requests
